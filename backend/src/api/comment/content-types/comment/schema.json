{
  "kind": "collectionType",
  "collectionName": "comments",
  "info": {
    "singularName": "comment",
    "pluralName": "comments",
    "displayName": "Comment",
    "description": "User comments on reviews (anonymous, moderated)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "body": {
      "type": "text",
      "required": true,
      "maxLength": 2000
    },
    "authorName": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "authorEmail": {
      "type": "email"
    },
    "approved": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "review": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::review.review",
      "inversedBy": "comments"
    }
  }
}
