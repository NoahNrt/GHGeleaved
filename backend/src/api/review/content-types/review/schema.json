{
  "kind": "collectionType",
  "collectionName": "reviews",
  "info": {
    "singularName": "review",
    "pluralName": "reviews",
    "displayName": "Review",
    "description": "Review articles for books, films, music, and games"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "genre": {
      "type": "enumeration",
      "enum": ["buch", "film", "musik", "spiel"],
      "required": true
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "coverUrl": {
      "type": "string",
      "maxLength": 500
    },
    "excerpt": {
      "type": "text",
      "maxLength": 300
    },
    "body": {
      "type": "blocks"
    },
    "bodyHtml": {
      "type": "text"
    },
    "rating": {
      "type": "integer",
      "min": 1,
      "max": 5
    },
    "subjectTitle": {
      "type": "string",
      "maxLength": 255
    },
    "subjectCreator": {
      "type": "string",
      "maxLength": 255
    },
    "subjectYear": {
      "type": "integer"
    },
    "authorName": {
      "type": "string",
      "maxLength": 120
    },
    "comments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::comment.comment",
      "mappedBy": "review"
    }
  }
}
